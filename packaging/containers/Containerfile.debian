# SPDX-License-Identifier: GPL-3.0-or-later

FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build git \
    libspdlog-dev libtomlplusplus-dev libasio-dev \
    libopus-dev libpipewire-0.3-dev libssl-dev \
    libprotobuf-dev protobuf-compiler libsqlite3-dev \
    libcatch2-dev libqt6widgets6-dev qt6-base-dev \
    dh-make debhelper lintian \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . /src

RUN chmod +x packaging/build-packages.sh

CMD ["bash", "packaging/build-packages.sh"]

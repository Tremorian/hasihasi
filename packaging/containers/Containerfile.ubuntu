# HasiHasi – Build-Container für Ubuntu 24.04 (Noble)
# SPDX-FileCopyrightText: 2026 Nils Pankoke <tremorian@mailbox.org>
# SPDX-License-Identifier: GPL-3.0-or-later

FROM ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build git \
    libspdlog-dev libtomlplusplus-dev libasio-dev \
    libopus-dev libpipewire-0.3-dev libssl-dev \
    libprotobuf-dev protobuf-compiler libsqlite3-dev \
    libcatch2-dev libqt6widgets6-dev qt6-base-dev \
    dh-make debhelper lintian \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

# Build-Skript kopieren und ausführbar machen
COPY packaging/build-packages.sh /src/packaging/build-packages.sh
RUN chmod +x /src/packaging/build-packages.sh

# Projekt-Dateien kopieren (nur notwendige)
COPY CMakeLists.txt /src/CMakeLists.txt
COPY CMakePresets.json /src/CMakePresets.json
COPY REUSE.toml /src/REUSE.toml
COPY LICENSE /src/LICENSE
COPY proto /src/proto
COPY libs /src/libs
COPY server /src/server
COPY client /src/client
COPY tools /src/tools
COPY tests /src/tests
COPY packaging /src/packaging

ENV DEBIAN_FRONTEND=noninteractive

# Build durchführen
RUN mkdir -p /output && \
    cmake --preset release -DCMAKE_INSTALL_PREFIX=/usr && \
    cmake --build --preset release && \
    ctest --preset release && \
    cmake --install build-release --prefix /usr && \
    cd packaging && \
    ./build-packages.sh --version ${VERSION:-0.1.0}

CMD ["bash", "-c", "echo 'Build abgeschlossen'"]

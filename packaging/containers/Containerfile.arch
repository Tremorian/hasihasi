FROM archlinux:base

RUN pacman -Syu --noconfirm \
    base-devel cmake ninja git \
    spdlog tomlplusplus asio opus pipewire openssl \
    protobuf sqlite catch2 qt6-base \
    && pacman -Sc --noconfirm

WORKDIR /src
COPY . /src

RUN chmod +x packaging/build-packages.sh

CMD ["bash", "packaging/build-packages.sh"]

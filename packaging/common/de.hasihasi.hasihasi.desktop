[Desktop Entry]
Type=Application
Name=HasiHasi
Comment=Low-Latency-Voice-Chat für Linux-Gamer
Exec=hasihasi %u
Icon=de.hasihasi.hasihasi
Terminal=false
Categories=VoiceChat;Networking;Game;
MimeType=x-scheme-handler/hasihasi;
StartupNotify=false
X-KDE-Protocols=hasihasi;

# Flatpak
DBusActivatable=true
